# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados MongoDB
MONGODB_URI=mongodb://localhost:27017/plantour

# JWT Secret (gere um secret seguro em produção)
JWT_SECRET=seu_jwt_secret_super_seguro_aqui_123456789

# Configurações de Email (para recuperação de senha futuramente)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_do_email

# Chaves de APIs externas (futuras integrações)
GOOGLE_MAPS_API_KEY=sua_chave_do_google_maps
WEATHER_API_KEY=sua_chave_do_clima